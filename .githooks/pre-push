#!/bin/sh
# pre-push — this repository's own intellisense gate, built from the checked-out source.
# CI runs the same gate from the pull request's base branch, so this is the early warning, not the guard.
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v go >/dev/null 2>&1 || { echo "[pre-push] Go is not installed — intellisense gate SKIPPED locally (CI still runs it)."; exit 0; }
exec go run ./cmd/intellisense gate --pre-push "$@"
