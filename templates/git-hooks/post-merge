# --- BEGIN intellisense HEARTBEAT POST-MERGE v1 ---
# Managed by setup.sh. Re-copies the heartbeat runtime when a `git pull` in
# INTELLISENSE_SETUP touches any tracked heartbeat file. Idempotent — re-running
# setup.sh replaces the content between these markers.
#
# Why: ~/.intellisense/bin/ holds a COPY (not a symlink) of the heartbeat
# runtime because macOS TCC denies launchd from reading executables under
# ~/Desktop, ~/Documents, ~/Downloads. The copy means `git pull` alone leaves
# the cron running stale parser/payload/prices until something re-copies.
# This block is that something.
#
# POSIX sh syntax — coexists with beads' sh-based hook driver.
if git rev-parse --verify ORIG_HEAD >/dev/null 2>&1; then
    _intellisense_repo="$(git rev-parse --show-toplevel 2>/dev/null)"
    _intellisense_refresh="$_intellisense_repo/scripts/refresh-heartbeat-runtime.sh"
    if [ -x "$_intellisense_refresh" ]; then
        _intellisense_changed=0
        for _intellisense_p in scripts/intellisense-heartbeat.sh \
                       scripts/lib/heartbeat-payload.sh \
                       scripts/lib/heartbeat_usage_parser.py \
                       scripts/lib/heartbeat-prices.json \
                       scripts/lib/hash.sh \
                       scripts/refresh-heartbeat-runtime.sh \
                       VERSION; do
            if git diff --name-only ORIG_HEAD HEAD -- "$_intellisense_p" 2>/dev/null | grep -q .; then
                _intellisense_changed=1
                break
            fi
        done
        if [ "$_intellisense_changed" = "1" ]; then
            "$_intellisense_refresh" --verbose || \
                echo "[post-merge] WARNING: refresh-heartbeat-runtime.sh failed; run 'bash setup.sh --refresh-runtime' manually" >&2
        fi
        unset _intellisense_repo _intellisense_refresh _intellisense_changed _intellisense_p
    fi
fi
# --- END intellisense HEARTBEAT POST-MERGE v1 ---
